config.stopBubbling = true
# FIXME: Lombok does not know this key yet, so it has no effect and every build prints
#   "Unknown key 'lombok.builder.toBuilder'". Still missing:
#   https://github.com/projectlombok/lombok/pull/3816
#   The records set @Builder(toBuilder = true) explicitly. The -Alombok.* compiler args in
#   pom.xml have no effect either. Remove both or wait for the Lombok release.
lombok.builder.toBuilder = true
lombok.builder.className = Builder
