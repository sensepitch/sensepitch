<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.sensepitch</groupId>
  <artifactId>sensepitch-edge</artifactId>
  <version>0.2-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <netty.version>4.2.20.Final</netty.version>
    <prometheus.version>1.10.0</prometheus.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <lombok.version>1.18.44</lombok.version>
    <jacoco.version>0.8.16</jacoco.version>
    <serenity.version>5.4.2</serenity.version>
    <bytebuddy.version>1.18.17</bytebuddy.version>
    <log4j.version>2.26.1</log4j.version>
    <jmh.version>1.37</jmh.version>
    <guava.version>33.8.0-jre</guava.version>
    <jackson.version>2.23.0</jackson.version>
    <!-- colon-free, so it can be part of a file name on any platform -->
    <maven.build.timestamp.format>yyyyMMddHHmmssSSS</maven.build.timestamp.format>
    <!-- overwritten by jacoco prepare-agent; empty default keeps surefire working when jacoco is skipped -->
    <jacocoArgLine></jacocoArgLine>
    <!-- ./mvnw test runs the unit test classes concurrently in one JVM, the methods of a class
         in order, with as many threads as CPU cores. Classes depending on JVM wide state carry
         @Isolated and run alone. Sequential: -Dtest.parallel=false -->
    <test.parallel>true</test.parallel>
    <!-- JUnit platform listeners that are not loaded: Serenity's reporting. Its listener records
         every test, writes about 1150 files to target/serenity-reports and generates reports at
         the end of the run, about a third of the unit test time. The step chains do not need
         it: step objects are created with new, so a failing step throws at once, see
         SerenityUsageTest. Reports on demand: -Dserenity.reports -->
    <test.deactivatedListeners>net.serenitybdd.junit5.SerenityTestExecutionListener</test.deactivatedListeners>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>${log4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j.version}</version>
    </dependency>
    <!-- routes java.util.logging to Log4j2, activated via the system property
         java.util.logging.manager, so JUL output ends up in the same place as all other logs -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-jul</artifactId>
      <version>${log4j.version}</version>
    </dependency>
    <!-- for log4j yaml config -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!-- https://mvnrepository.com/artifact/org.apache.logging.log4j/log4j-slf4j2-impl -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>${log4j.version}</version>
      <scope>compile</scope>
    </dependency>

    <!-- Netty core transport -->
    <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-transport</artifactId>
        <version>${netty.version}</version>
    </dependency>
    <!-- HTTP/1 codec -->
    <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-codec-http</artifactId>
        <version>${netty.version}</version>
    </dependency>
    <!-- HTTP/2 support -->
    <!--
    <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-codec-http2</artifactId>
        <version>${netty.version}</version>
    </dependency>
    -->
    <!-- SSL/TLS and ALPN -->
    <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-handler</artifactId>
        <version>${netty.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.prometheus</groupId>
      <artifactId>prometheus-metrics-core</artifactId>
      <version>${prometheus.version}</version>
    </dependency>
    <dependency>
      <groupId>io.prometheus</groupId>
      <artifactId>prometheus-metrics-instrumentation-jvm</artifactId>
      <version>${prometheus.version}</version>
    </dependency>
    <dependency>
      <groupId>io.prometheus</groupId>
      <artifactId>prometheus-metrics-exporter-httpserver</artifactId>
      <version>${prometheus.version}</version>
    </dependency>
    <!-- read and dump configuration -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.7</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.14.1</version>
    </dependency>
    <!-- for reading the Google JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.maxmind.geoip2</groupId>
      <artifactId>geoip2</artifactId>
      <version>4.4.0</version>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-tcnative-boringssl-static</artifactId>
      <version>2.0.85.Final</version>
    </dependency>

    <!-- JUnit 5 for testing -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- explicit launcher brings in commons ≥ 1.9.2 -->

    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
   <dependency>
    <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Serenity-BDD integration for JUnit5 -->
    <dependency>
      <groupId>net.serenity-bdd</groupId>
      <artifactId>serenity-junit5</artifactId>
      <version>${serenity.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.serenity-bdd</groupId>
      <artifactId>serenity-core</artifactId>
      <version>${serenity.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <version>${bytebuddy.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- official OTLP message classes, to verify the hand written OTLP encoding in tests.
         Production code has no dependency on protobuf, see ProtobufWriter -->
    <dependency>
      <groupId>io.opentelemetry.proto</groupId>
      <artifactId>opentelemetry-proto</artifactId>
      <version>1.11.1-alpha</version>
      <scope>test</scope>
    </dependency>
    <!-- microbenchmarks, see Ja4Benchmark. Not run by surefire, launched via its main() -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.junit</groupId>
      <artifactId>junit-bom</artifactId>
      <version>${junit.version}</version>
      <type>pom</type>
      <scope>import</scope>
    </dependency>
    <!-- one Jackson version for databind, dataformat-yaml and the transitive pulls (e.g. geoip2) -->
    <dependency>
      <groupId>com.fasterxml.jackson</groupId>
      <artifactId>jackson-bom</artifactId>
      <version>${jackson.version}</version>
      <type>pom</type>
      <scope>import</scope>
    </dependency>
    <!-- serenity pulls guava 33.3.1 transitively; 33.4.5+ dropped sun.misc.Unsafe on Java 9+ -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>${guava.version}</version>
    </dependency>
    <!-- serenity and junit pull an older byte-buddy, keep it at the version of the agent -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${bytebuddy.version}</version>
    </dependency>
  </dependencies>
</dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Commit and build time (UTC) for edge.build.version below. -->
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>10.0.1</version>
        <executions>
          <execution>
            <phase>initialize</phase>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <abbrevLength>7</abbrevLength>
          <dateFormat>yyyyMMdd.HHmmss</dateFormat>
          <dateFormatTimeZone>UTC</dateFormatTimeZone>
          <generateGitPropertiesFile>false</generateGitPropertiesFile>
          <includeOnlyProperties>
            <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
            <includeOnlyProperty>^git.build.time$</includeOnlyProperty>
          </includeOnlyProperties>
        </configuration>
      </plugin>
      <!-- The version written to the manifest of the fat JAR: SNAPSHOT replaced by build time and
           commit, e.g. 0.2-20261112.153045-dbe0c1a, so each built JAR is identifiable.
           A release version stays as is. Must follow the git plugin, both run in initialize. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>edge-build-version</id>
            <phase>initialize</phase>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>edge.build.version</name>
              <value>${project.version}</value>
              <regex>SNAPSHOT$</regex>
              <replacement>${git.build.time}-${git.commit.id.abbrev}</replacement>
              <failIfNoMatch>false</failIfNoMatch>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
           copy the correct version for serenity to the target directory to have a stable
           path to use in the surefire command line. ChatGPT says that is most portable ;jw
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>copy-bytebuddy-agent</id>
            <phase>test-compile</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>net.bytebuddy</groupId>
                  <artifactId>byte-buddy-agent</artifactId>
                  <version>${bytebuddy.version}</version>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <destFileName>byte-buddy-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{jacocoArgLine} -javaagent:${project.build.directory}/byte-buddy-agent.jar
            --enable-native-access=ALL-UNNAMED -XX:NativeMemoryTracking=summary</argLine>
          <properties>
            <configurationParameters>
              junit.jupiter.execution.parallel.enabled = ${test.parallel}
              junit.jupiter.execution.parallel.mode.default = same_thread
              junit.jupiter.execution.parallel.mode.classes.default = concurrent
            </configurationParameters>
          </properties>
          <systemPropertyVariables>
            <!-- JUL to Log4j2, so it is silent and capturable like everything else -->
            <java.util.logging.manager>org.apache.logging.log4j.jul.LogManager</java.util.logging.manager>
            <!-- Serenity's SerenityTestExecutionListener, loaded for every test, builds a byte-buddy
                 AgentBuilder, whose nexus initialization calls sun.misc.Unsafe and prints a
                 warning. Serenity records no steps here, so the nexus is not needed -->
            <net.bytebuddy.nexus.disabled>true</net.bytebuddy.nexus.disabled>
            <junit.platform.execution.listeners.deactivate>${test.deactivatedListeners}</junit.platform.execution.listeners.deactivate>
          </systemPropertyVariables>
        </configuration>
    </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <!-- failsafe does not inherit the surefire configuration, so repeat the agent here -->
          <!-- jacoco agent as in surefire, both append to target/jacoco.exec, so the report includes the ITs -->
          <argLine>@{jacocoArgLine} -javaagent:${project.build.directory}/byte-buddy-agent.jar --enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <java.util.logging.manager>org.apache.logging.log4j.jul.LogManager</java.util.logging.manager>
            <!-- see surefire -->
            <net.bytebuddy.nexus.disabled>true</net.bytebuddy.nexus.disabled>
            <junit.platform.execution.listeners.deactivate>${test.deactivatedListeners}</junit.platform.execution.listeners.deactivate>
            <!-- the fat JAR built by shade in the package phase, launched by ShadedJarIT -->
            <shadedJar>${project.build.directory}/${project.build.finalName}-with-dependencies.jar</shadedJar>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <!-- report to target/site/jacoco/index.html -->
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <!-- coverage floor, slightly below the actual coverage, raise it when coverage improves -->
            <id>jacoco-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.89</minimum>
                    </limit>
                  </limits>
                </rule>
                <!-- the generic request log posting is held at full coverage: a gap points to
                     error handling that is not needed or to a design that should change -->
                <rule>
                  <element>CLASS</element>
                  <includes>
                    <include>org.sensepitch.edge.HttpBatchSender*</include>
                    <include>org.sensepitch.edge.CircuitBreaker*</include>
                    <include>org.sensepitch.edge.Backoff*</include>
                    <include>org.sensepitch.edge.RandomNumberProvider*</include>
                    <include>org.sensepitch.edge.ThreadBatcher*</include>
                    <include>org.sensepitch.edge.BatchingRequestLogger*</include>
                    <include>org.sensepitch.edge.Batch</include>
                    <include>org.sensepitch.edge.OtlpBatchPayload*</include>
                    <include>org.sensepitch.edge.OtlpBatch</include>
                    <include>org.sensepitch.edge.GzipCompressor</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.0</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.0</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
          <!-- TEMPORARY: work in progress that does not compile yet. Drop both blocks once
               Ja4Fingerprint exists and the JMH dependencies are declared.
               HttpFingerprint calls the missing class Ja4Fingerprint, Ja4Benchmark needs
               jmh-core and jmh-generator-annprocess. Nothing in src/main references the
               HttpFingerprint classes, so leaving them out is safe. -->
          <excludes>
            <exclude>**/HttpFingerprint*.java</exclude>
          </excludes>
          <testExcludes>
            <exclude>**/HttpFingerprint*.java</exclude>
            <exclude>**/Ja4Benchmark.java</exclude>
          </testExcludes>
        </configuration>
        <executions>
          <execution>
            <!-- the JMH benchmark generator only needs to run over the test sources. Execution
                 level configuration replaces the inherited processor list, so Lombok is repeated. -->
            <id>default-testCompile</id>
            <goals><goal>testCompile</goal></goals>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.projectlombok</groupId>
                  <artifactId>lombok</artifactId>
                  <version>${lombok.version}</version>
                </path>
                <path>
                  <groupId>org.openjdk.jmh</groupId>
                  <artifactId>jmh-generator-annprocess</artifactId>
                  <version>${jmh.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- javadoc parses sources, so it cannot see Lombok-generated members
             (e.g. DeflectorConfig.Builder). Generate plain sources for it. -->
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok-maven-plugin</artifactId>
        <version>1.18.20.0</version>
        <dependencies>
          <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <!-- only the javadoc check below reads the output, so run it in verify (declared
                 before the javadoc plugin, so it runs first) and not in every compile/test,
                 where it cost ~3s. Standalone: ./mvnw lombok:delombok javadoc:javadoc -->
            <phase>verify</phase>
            <goals>
              <goal>delombok</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
          <outputDirectory>${project.build.directory}/generated-sources/delombok</outputDirectory>
          <!-- javadoc only; must not become a second compile source root -->
          <addOutputDirectory>false</addOutputDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <executions>
          <execution>
            <!-- make the doc build part of the normal check phase; no-fork because
                 delombok already ran earlier in the verify phase of this same build -->
            <id>check-javadoc</id>
            <phase>verify</phase>
            <goals>
              <goal>javadoc-no-fork</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <sourcepath>${project.build.directory}/generated-sources/delombok</sourcepath>
          <!-- Doc comments are Markdown (JEP 467). doclint reports unresolvable [Ref] links,
               which javadoc would otherwise render as an "invalid reference" box, and malformed
               block tags. -missing: most of the code is intentionally undocumented. -->
          <doclint>all,-missing</doclint>
          <failOnError>true</failOnError>
          <!-- The plugin skips the run when the previous javadoc command line was identical,
               which ignores edits inside the doc comments themselves: an incremental
               `mvn verify` would report "everything is up to date" and pass on a broken
               reference. A per-build path means there is never previous run data. -->
          <staleDataPath>${project.build.directory}/javadoc-check/${maven.build.timestamp}.txt</staleDataPath>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <!-- run shade in the package phase -->
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- keep the original JAR -->
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <!-- give the fat-jar a suffix -->
              <shadedClassifierName>with-dependencies</shadedClassifierName>

              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- extra manifests & signatures -->
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <!-- Java-9 multi-release module descriptors -->
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                    <!-- Module descriptors are meaningless in a classpath fat JAR. Avoids:
                         [WARNING] Discovered module-info.class. Shading will break its strong encapsulation. -->
                    <exclude>module-info.class</exclude>
                    <!-- Netty’s version map (only one needed) -->
                    <exclude>META-INF/io.netty.versions.properties</exclude>
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>META-INF/NOTICE*</exclude>
                    <!-- Apache dependency listing, informational only. Avoids:
                         [WARNING] log4j-api-2.26.1.jar, log4j-core-2.26.1.jar, log4j-jul-2.26.1.jar,
                           log4j-slf4j2-impl-2.26.1.jar define 1 overlapping resource:
                         [WARNING]   - META-INF/DEPENDENCIES -->
                    <exclude>META-INF/DEPENDENCIES</exclude>
                  </excludes>
                </filter>
                <!-- Maven metadata of the tcnative jar and its native classifier jars. Avoids:
                     [WARNING] netty-tcnative-boringssl-static-2.0.85.Final-linux-aarch_64.jar, ...,
                       netty-tcnative-boringssl-static-2.0.85.Final.jar define 2 overlapping resources:
                     [WARNING]   - META-INF/maven/io.netty/netty-tcnative-boringssl-static/pom.properties
                     [WARNING]   - META-INF/maven/io.netty/netty-tcnative-boringssl-static/pom.xml -->
                <filter>
                  <artifact>io.netty:netty-tcnative-boringssl-static</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
                <!-- Each native classifier jar ships the same license texts; keep the copy from
                     linux-x86_64 only. Avoids:
                     [WARNING] netty-tcnative-boringssl-static-2.0.85.Final-linux-aarch_64.jar, ...,
                       netty-tcnative-boringssl-static-2.0.85.Final-windows-x86_64.jar define 3 overlapping resources:
                     [WARNING]   - META-INF/license/LICENSE.boringssl.txt
                     [WARNING]   - META-INF/license/LICENSE.mvn-wrapper.txt
                     [WARNING]   - META-INF/license/LICENSE.tomcat-native.txt -->
                <filter>
                  <artifact>io.netty:netty-tcnative-boringssl-static:*:linux-aarch_64</artifact>
                  <excludes>
                    <exclude>META-INF/license/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>io.netty:netty-tcnative-boringssl-static:*:osx-*</artifact>
                  <excludes>
                    <exclude>META-INF/license/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>io.netty:netty-tcnative-boringssl-static:*:windows-*</artifact>
                  <excludes>
                    <exclude>META-INF/license/**</exclude>
                  </excludes>
                </filter>
              </filters>

              <!-- set the main class in the manifest -->
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.sensepitch.edge.Main</mainClass>
                  <!-- read via Package.getImplementationVersion(), sent as service.version.
                       Unique per build for snapshots, see edge.build.version -->
                  <manifestEntries>
                    <Implementation-Version>${edge.build.version}</Implementation-Version>
                    <!-- same as the command line flag documented in the README. tcnative and netty
                         need native access, without it java -jar prints:
                         WARNING: A restricted method in java.lang.System has been called
                         WARNING: java.lang.System::loadLibrary has been called by io.netty.util.internal.NativeLibraryUtil
                           in an unnamed module (file:.../sensepitch-edge-*-with-dependencies.jar)
                         WARNING: Use enable-native-access=ALL-UNNAMED to avoid a warning for callers in this module
                         WARNING: Restricted methods will be blocked in a future release unless native access is enabled -->
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
                <!-- Merge ServiceLoader registrations instead of keeping only one jar's file,
                     which would drop e.g. YAMLFactory/YAMLMapper. Avoids:
                     [WARNING] jackson-core-2.23.0.jar, jackson-dataformat-yaml-2.23.0.jar define 1 overlapping resource:
                     [WARNING]   - META-INF/services/com.fasterxml.jackson.core.JsonFactory
                     [WARNING] jackson-databind-2.23.0.jar, jackson-dataformat-yaml-2.23.0.jar define 1 overlapping resource:
                     [WARNING]   - META-INF/services/com.fasterxml.jackson.core.ObjectCodec -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>

              <!-- (optional) relocate deps to avoid class-path clashes -->
              <!--
              <relocations>
                <relocation>
                  <pattern>com.google.common</pattern>
                  <shadedPattern>shade.com.google.common</shadedPattern>
                </relocation>
              </relocations>
              -->
            </configuration>
          </execution>
        </executions>
      </plugin>


      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <!-- 1.37+ cannot be loaded by Spotless (Style.valueOf), 2.x changes the lambda layout -->
              <version>1.36.1</version>
              <style>GOOGLE</style>
              <!-- leave doc comments alone, google-java-format would reflow the Markdown /// comments -->
              <formatJavadoc>false</formatJavadoc>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- ./mvnw verify -Dfast: compiles, runs all unit and integration tests and builds the fat
           JAR, but leaves out what is not needed to see whether the code works: coverage
           (agent, report and floor), the Javadoc build with its delombok, and the format check.
           For the inner loop only, the full gate before a commit is ./mvnw verify.
           Each part can also be skipped on its own, e.g. -Djacoco.skip -->
      <id>fast</id>
      <activation>
        <property>
          <name>fast</name>
        </property>
      </activation>
      <properties>
        <jacoco.skip>true</jacoco.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <lombok.delombok.skip>true</lombok.delombok.skip>
        <spotless.check.skip>true</spotless.check.skip>
      </properties>
    </profile>
    <profile>
      <!-- ./mvnw test -Dserenity.reports: Serenity records the tests in target/serenity-reports -->
      <id>serenity-reports</id>
      <activation>
        <property>
          <name>serenity.reports</name>
        </property>
      </activation>
      <properties>
        <test.deactivatedListeners>none</test.deactivatedListeners>
      </properties>
    </profile>
    <profile>
      <!-- VS Code and Eclipse (m2e) compile into their own directory, so their background builds
           never overwrite the classes of a Maven build in target/ -->
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <build>
        <directory>${project.basedir}/target-ide</directory>
      </build>
    </profile>
  </profiles>

</project>
